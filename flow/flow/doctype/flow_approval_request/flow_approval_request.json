   "print": 1,
   "report": 1,
   "share": 1
  },
  {
   "role": "System Manager",
   "permlevel": 1,
   "read": 1,
   "write": 1
  },
  {
   "role": "All",
   "if_owner": 1,
   "read": 1,
   "write": 1,
   "create": 1
  }
 ],
 "sort_field": "creation",
 "sort_order": "DESC",
 "states": [],
 "track_changes": 1,
 "title_field": "title",
 "search_fields": "title,status,ref_name"
}
